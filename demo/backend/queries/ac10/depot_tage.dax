-- View 1 Depot x Tag heatmap: every dim_scope Mandant x Depot pair (zero-shift depots and the "(unbekannt)"
-- = kein-Depot error rows included, R4) x every day of the window. The measures return 0, not blank, so
-- SUMMARIZECOLUMNS keeps every pair x day (auto-exist keeps only real Mandant x Depot pairs of dim_scope).
-- No depot filter: the heatmap shows all depots and highlights the picked one.
-- Filters (README "Filters and params"): mandant / depot / haupttyp / kategorie are ORDINALS into the
-- model's sorted value lists (same rule as scope.dax), zwingend = alle | zwingend | nicht. Absent = no filter.
-- The zwingend part uses KEEPFILTERS so it intersects with the zwingend filter instead of overriding it.
EVALUATE
VAR _fD = FILTER ( ALL ( 'dim_date'[datum] ), 'dim_date'[datum] >= {{date_from}} && 'dim_date'[datum] <= {{date_to}} )
VAR _mix = {{mandant}}
VAR _fM =
    FILTER ( ALL ( 'dim_scope'[tenant_name] ),
        ISBLANK ( _mix ) || ( NOT ISBLANK ( 'dim_scope'[tenant_name] )
            && 1 + COUNTROWS ( FILTER ( ALL ( 'dim_scope'[tenant_name] ), NOT ISBLANK ( 'dim_scope'[tenant_name] ) && 'dim_scope'[tenant_name] < EARLIER ( 'dim_scope'[tenant_name] ) ) ) = _mix ) )
VAR _hix = {{haupttyp}}
VAR _fH =
    FILTER ( ALL ( 'dim_scope'[haupttyp_name] ),
        ISBLANK ( _hix ) || ( NOT ISBLANK ( 'dim_scope'[haupttyp_name] )
            && 1 + COUNTROWS ( FILTER ( ALL ( 'dim_scope'[haupttyp_name] ), NOT ISBLANK ( 'dim_scope'[haupttyp_name] ) && 'dim_scope'[haupttyp_name] < EARLIER ( 'dim_scope'[haupttyp_name] ) ) ) = _hix ) )
VAR _z = {{zwingend}}
VAR _fZ =
    FILTER ( ALL ( 'fact_shift_besetzung'[is_zwingend_zu_besetzen] ),
        ISBLANK ( _z ) || _z = "alle"
            || ( _z = "zwingend" && 'fact_shift_besetzung'[is_zwingend_zu_besetzen] = TRUE () )
            || ( _z = "nicht" && 'fact_shift_besetzung'[is_zwingend_zu_besetzen] = FALSE () ) )
RETURN
    SUMMARIZECOLUMNS ( 'dim_scope'[tenant_name], 'dim_scope'[depot_name], 'dim_date'[datum], _fD, _fM, _fH, _fZ,
        "ungeplant", [Anzahl ungeplante Schichten],
        "ungeplant_zwingend", CALCULATE ( [Anzahl ungeplante Schichten], KEEPFILTERS ( 'fact_shift_besetzung'[is_zwingend_zu_besetzen] = TRUE () ) ),
        "schichten", [Anzahl Schichten]
    )
ORDER BY 'dim_scope'[tenant_name], 'dim_scope'[depot_name], 'dim_date'[datum]

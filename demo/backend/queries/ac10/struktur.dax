-- View 2 Struktur (treemap) <-> Rangliste (bars): Mandant subtotal rows (ebene "mandant", depot blank) and
-- Mandant x Depot rows (ebene "depot") for the window, every dim_scope depot included (R4). The subtotals are
-- the model's own numbers per Mandant, so the treemap never sums depots in the browser.
-- No Mandant / Depot filter: this view IS the Mandant / Depot picker.
-- Filters (README "Filters and params"): mandant / depot / haupttyp / kategorie are ORDINALS into the
-- model's sorted value lists (same rule as scope.dax), zwingend = alle | zwingend | nicht. Absent = no filter.
-- The zwingend part uses KEEPFILTERS so it intersects with the zwingend filter instead of overriding it.
EVALUATE
VAR _fD = FILTER ( ALL ( 'dim_date'[datum] ), 'dim_date'[datum] >= {{date_from}} && 'dim_date'[datum] <= {{date_to}} )
VAR _hix = {{haupttyp}}
VAR _fH =
    FILTER ( ALL ( 'dim_scope'[haupttyp_name] ),
        ISBLANK ( _hix ) || ( NOT ISBLANK ( 'dim_scope'[haupttyp_name] )
            && 1 + COUNTROWS ( FILTER ( ALL ( 'dim_scope'[haupttyp_name] ), NOT ISBLANK ( 'dim_scope'[haupttyp_name] ) && 'dim_scope'[haupttyp_name] < EARLIER ( 'dim_scope'[haupttyp_name] ) ) ) = _hix ) )
VAR _z = {{zwingend}}
VAR _fZ =
    FILTER ( ALL ( 'fact_shift_besetzung'[is_zwingend_zu_besetzen] ),
        ISBLANK ( _z ) || _z = "alle"
            || ( _z = "zwingend" && 'fact_shift_besetzung'[is_zwingend_zu_besetzen] = TRUE () )
            || ( _z = "nicht" && 'fact_shift_besetzung'[is_zwingend_zu_besetzen] = FALSE () ) )
VAR _dep =
    SUMMARIZECOLUMNS ( 'dim_scope'[tenant_name], 'dim_scope'[depot_name], _fD, _fH, _fZ,
        "@u", [Anzahl ungeplante Schichten], "@z", CALCULATE ( [Anzahl ungeplante Schichten], KEEPFILTERS ( 'fact_shift_besetzung'[is_zwingend_zu_besetzen] = TRUE () ) ),
        "@s", [Anzahl Schichten], "@q", [Besetzungsquote] )
VAR _man =
    SUMMARIZECOLUMNS ( 'dim_scope'[tenant_name], _fD, _fH, _fZ,
        "@u", [Anzahl ungeplante Schichten], "@z", CALCULATE ( [Anzahl ungeplante Schichten], KEEPFILTERS ( 'fact_shift_besetzung'[is_zwingend_zu_besetzen] = TRUE () ) ),
        "@s", [Anzahl Schichten], "@q", [Besetzungsquote] )
RETURN
    UNION (
        SELECTCOLUMNS ( _man, "ebene", "mandant", "mandant", 'dim_scope'[tenant_name], "depot", CONVERT ( BLANK (), STRING ),
            "ungeplant", [@u], "ungeplant_zwingend", [@z], "schichten", [@s], "besetzungsquote", [@q] ),
        SELECTCOLUMNS ( _dep, "ebene", "depot", "mandant", 'dim_scope'[tenant_name], "depot", 'dim_scope'[depot_name],
            "ungeplant", [@u], "ungeplant_zwingend", [@z], "schichten", [@s], "besetzungsquote", [@q] )
    )
ORDER BY [ebene] DESC, [mandant], [depot]

{
  "model": "platform_metrics",
  "replaces": "clusteredBarChart 60fad317b502cd62f3bc (step x Regime CV)",
  "view": "Step stability",
  "grain": "step (all stages that share a step name are pooled, as in the report bar)",
  "params": {
    "env": {
      "type": "enum",
      "required": true,
      "values": [
        "PROD",
        "QA"
      ],
      "filter_column": "'dim_env'[env]"
    },
    "tenant": {
      "type": "enum",
      "required": true,
      "values": [
        "RTS",
        "CARGOCONTROL"
      ],
      "filter_column": "'dim_env'[tenant]"
    },
    "dates": {
      "type": "date_window",
      "default_days": 90,
      "anchor": "to_today"
    }
  },
  "columns": {
    "step": "label_technical",
    "regime_cv": "measure"
  }
}

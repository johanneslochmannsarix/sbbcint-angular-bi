-- page: Trend by tenant / env / batch
-- replaces: lineChart 286364ea3041c9dde0a9 (batch_id x Delivered Size (GiB))
-- grain: batch_id
-- delivered batches only: fact_csv_file[is_delivered] (done/ before ADR-056, processed/…-done since; superseded / failed excluded), 2026-10-22.
EVALUATE
SUMMARIZECOLUMNS (
    'fact_csv_file'[batch_id],
    TREATAS ( { TRUE () }, 'fact_csv_file'[is_delivered] ),
    {{env_filter}},
    {{tenant_filter}},
    FILTER ( ALL ( 'dim_date'[date] ), 'dim_date'[date] >= {{date_from}} && 'dim_date'[date] <= {{date_to}} ),
    "delivered_size_gib", [Delivered Size (GiB)]
)
ORDER BY 'fact_csv_file'[batch_id]

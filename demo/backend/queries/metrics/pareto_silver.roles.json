{
  "model": "platform_metrics",
  "replaces": "clusteredBarChart 4453cfcc7c6393b44f05 (key x Silver s/run)",
  "view": "Entity / table Pareto",
  "grain": "key",
  "params": {
    "env": {
      "type": "enum",
      "required": true,
      "values": [
        "PROD",
        "QA"
      ],
      "filter_column": "'dim_env'[env]"
    },
    "tenant": {
      "type": "enum",
      "required": true,
      "values": [
        "RTS",
        "CARGOCONTROL"
      ],
      "filter_column": "'dim_env'[tenant]"
    },
    "dates": {
      "type": "date_window",
      "default_days": 30,
      "anchor": "to_today"
    }
  },
  "columns": {
    "key": "label_technical",
    "silver_s_per_run": "measure"
  }
}

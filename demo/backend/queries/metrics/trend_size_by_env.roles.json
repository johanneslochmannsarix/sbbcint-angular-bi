{
  "model": "platform_metrics",
  "replaces": "lineChart 0533ac481d318abe6d9b (batch_date x Size per Batch (GiB), series env)",
  "view": "Trend by tenant / env / batch",
  "grain": "batch_date x env",
  "params": {
    "env": {
      "type": "enum",
      "required": false,
      "values": [
        "PROD",
        "QA"
      ],
      "filter_column": "'dim_env'[env]"
    },
    "tenant": {
      "type": "enum",
      "required": false,
      "values": [
        "RTS",
        "CARGOCONTROL"
      ],
      "filter_column": "'dim_env'[tenant]"
    },
    "dates": {
      "type": "date_window",
      "default_days": 90,
      "anchor": "to_today"
    }
  },
  "columns": {
    "batch_date": "date",
    "env": "code",
    "size_per_batch_gib": "measure"
  }
}

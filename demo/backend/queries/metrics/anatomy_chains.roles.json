{
  "model": "platform_metrics",
  "replaces": "(new) chain picker for the Gantt; no report visual",
  "view": "Run anatomy (ADR-055)",
  "grain": "run_id (one chain run with activity detail)",
  "params": {
    "env": {
      "type": "enum",
      "required": true,
      "values": [
        "PROD",
        "QA"
      ],
      "filter_column": "'dim_env'[env]"
    },
    "tenant": {
      "type": "enum",
      "required": false,
      "values": [
        "RTS",
        "CARGOCONTROL"
      ],
      "filter_column": "'dim_env'[tenant]"
    },
    "dates": {
      "type": "date_window",
      "default_days": 30,
      "anchor": "to_today"
    }
  },
  "columns": {
    "run_id": "id",
    "tenant": "code",
    "env": "code",
    "chain_start": "date",
    "chain_end": "date",
    "exec_min": "measure",
    "session_queued_min": "measure",
    "retries": "measure"
  }
}

-- page: Entity / table Pareto
-- replaces: scatterChart 93aeced5dc923f208e43 (key: X Ingest MiB/file, Y Ingest s/file)
-- grain: key
EVALUATE
SUMMARIZECOLUMNS (
    'fact_run_step'[key],
    {{env_filter}},
    {{tenant_filter}},
    FILTER ( ALL ( 'dim_date'[date] ), 'dim_date'[date] >= {{date_from}} && 'dim_date'[date] <= {{date_to}} ),
    "ingest_mib_per_file", [Ingest MiB/file],
    "ingest_s_per_file", [Ingest s/file]
)
ORDER BY [ingest_s_per_file] DESC

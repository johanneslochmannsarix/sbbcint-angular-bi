{
  "model": "platform_metrics",
  "replaces": "columnChart 5f731aedba2010d5bba0 (stage x Session queued / running min)",
  "view": "Run anatomy (ADR-055)",
  "grain": "stage",
  "params": {
    "env": {
      "type": "enum",
      "required": true,
      "values": [
        "PROD",
        "QA"
      ],
      "filter_column": "'dim_env'[env]"
    },
    "tenant": {
      "type": "enum",
      "required": false,
      "values": [
        "RTS",
        "CARGOCONTROL"
      ],
      "filter_column": "'dim_env'[tenant]"
    },
    "dates": {
      "type": "date_window",
      "default_days": 30,
      "anchor": "to_today"
    }
  },
  "columns": {
    "stage": "code",
    "session_queued_min": "measure",
    "session_running_min": "measure"
  }
}

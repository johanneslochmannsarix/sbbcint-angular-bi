{
  "model": "platform_metrics",
  "replaces": "lineChart 286364ea3041c9dde0a9 (batch_id x Delivered Size (GiB))",
  "view": "Trend by tenant / env / batch",
  "grain": "batch_id",
  "params": {
    "env": {
      "type": "enum",
      "required": false,
      "values": [
        "PROD",
        "QA"
      ],
      "filter_column": "'dim_env'[env]"
    },
    "tenant": {
      "type": "enum",
      "required": false,
      "values": [
        "RTS",
        "CARGOCONTROL"
      ],
      "filter_column": "'dim_env'[tenant]"
    },
    "dates": {
      "type": "date_window",
      "default_days": 90,
      "anchor": "to_today"
    }
  },
  "columns": {
    "batch_id": "id",
    "delivered_size_gib": "measure"
  }
}

{
  "model": "platform_metrics",
  "replaces": "lineClusteredColumnComboChart fcbb941ab55d9c6523aa (key x Ingest s/file top20, Ingest MiB/file top20)",
  "view": "Entity / table Pareto",
  "grain": "key (the 20 slowest files; the measures are BLANK for the rest, so SUMMARIZECOLUMNS drops them)",
  "params": {
    "env": {
      "type": "enum",
      "required": true,
      "values": [
        "PROD",
        "QA"
      ],
      "filter_column": "'dim_env'[env]"
    },
    "tenant": {
      "type": "enum",
      "required": true,
      "values": [
        "RTS",
        "CARGOCONTROL"
      ],
      "filter_column": "'dim_env'[tenant]"
    },
    "dates": {
      "type": "date_window",
      "default_days": 30,
      "anchor": "to_today"
    }
  },
  "columns": {
    "key": "label_technical",
    "ingest_s_per_file_top20": "measure",
    "ingest_mib_per_file_top20": "measure"
  }
}

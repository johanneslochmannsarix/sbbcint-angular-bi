-- page: Entity / table Pareto
-- replaces: clusteredBarChart 4453cfcc7c6393b44f05 (key x Silver s/run)
-- grain: key
EVALUATE
SUMMARIZECOLUMNS (
    'fact_run_step'[key],
    {{env_filter}},
    {{tenant_filter}},
    FILTER ( ALL ( 'dim_date'[date] ), 'dim_date'[date] >= {{date_from}} && 'dim_date'[date] <= {{date_to}} ),
    "silver_s_per_run", [Silver s/run]
)
ORDER BY [silver_s_per_run] DESC

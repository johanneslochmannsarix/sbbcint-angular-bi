{
  "model": "import",
  "tenant": "RTS",
  "replaces": "«Qualifikationsmatrix» with the qualification slicer, read along Gültig bis (Anzeige); no report visual lists expiries by day",
  "view": "2 calendar day list (click a day)",
  "grain": "one row per fact row whose valid_to falls in [date_from, date_to]",
  "params": {
    "dates": {
      "type": "date_window",
      "anchor": "from_today",
      "default_days": 365
    },
    "qualification": {
      "type": "sk",
      "required": false,
      "filter_column": "'dim_qualification'[qualification_sk]"
    }
  },
  "columns": {
    "person_sk": "label_person",
    "person_name": "label_person",
    "qualification_name": "label_qualification",
    "status_code": "code",
    "valid_to": "date"
  },
  "person_key": "person_sk"
}

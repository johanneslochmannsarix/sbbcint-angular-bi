-- View 1 band above the Menge calendar and view 4 heatmap: one row per Standort × day of ONE month (default =
-- the model's Vormonat). Tours by Tour-Standort; family absences and the merged «übrige Abwesenheit + ohne
-- Eintrag» by Heimatstandort (D2). Q1 ruling (a), 2026-10-21: at this grain the two person-less counts are
-- returned ONLY as their sum - next to the person cells of the calendar a separate «übrige» count of 1 would name
-- the person. Haupttyp filters tours only.
DEFINE
    VAR _m = {{month}}
    VAR _ml = IF ( ISBLANK ( _m ),
        CALCULATE ( MIN ( dim_tag_nachbereitung_cd[monat_label] ), dim_tag_nachbereitung_cd[zeitraum] = "Vormonat" ),
        FORMAT ( _m, "yyyy-MM" ) )
    VAR _fM = TREATAS ( { _ml }, dim_tag_nachbereitung_cd[monat_label] )
    VAR _s = {{standort}}
    VAR _sN = MAXX ( FILTER ( ALL ( dim_standort_nachbereitung_cd[standort_name] ),
        RANKX ( ALL ( dim_standort_nachbereitung_cd[standort_name] ), dim_standort_nachbereitung_cd[standort_name], , ASC, DENSE ) = _s ),
        dim_standort_nachbereitung_cd[standort_name] )
    VAR _fS = FILTER ( ALL ( dim_standort_nachbereitung_cd[standort_name] ), ISBLANK ( _s ) || dim_standort_nachbereitung_cd[standort_name] = _sN )
    VAR _h = {{haupttyp}}
    VAR _hN = MAXX ( FILTER ( ALL ( fact_tour_cd[personaltyp_haupttyp] ),
        RANKX ( ALL ( fact_tour_cd[personaltyp_haupttyp] ), fact_tour_cd[personaltyp_haupttyp], , ASC, DENSE ) = _h ),
        fact_tour_cd[personaltyp_haupttyp] )
    VAR _fH = FILTER ( ALL ( fact_tour_cd[personaltyp_haupttyp] ), ISBLANK ( _h ) || fact_tour_cd[personaltyp_haupttyp] = _hN )
EVALUATE
SELECTCOLUMNS (
    SUMMARIZECOLUMNS (
        dim_standort_nachbereitung_cd[standort_name],
        dim_tag_nachbereitung_cd[datum],
        _fM, _fS, _fH,
        "@touren", [Anzahl Touren],
        "@besetzt", [Touren besetzt],
        "@offen", [Touren offen],
        "@verkauft", [Verkaufte Touren],
        "@offen_nicht_verkauft", CALCULATE ( [Touren offen], KEEPFILTERS ( fact_tour_cd[ist_verkaufte_tour] = FALSE () ) ),
        "@familie", [Abwesenheitstage],
        "@rest", [Abwesenheitstage übrige] + [Tage ohne Eintrag]
    ),
    "standort", dim_standort_nachbereitung_cd[standort_name],
    "datum", dim_tag_nachbereitung_cd[datum],
    "touren", [@touren] + 0,
    "besetzt", [@besetzt] + 0,
    "offen", [@offen] + 0,
    "verkauft", [@verkauft] + 0,
    "offen_nicht_verkauft", [@offen_nicht_verkauft] + 0,
    "familie", [@familie] + 0,
    "uebrige_oder_ohne", [@rest] + 0
)
ORDER BY [standort], [datum]

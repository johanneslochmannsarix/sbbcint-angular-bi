-- View 1, the «SBB CD Menge» calendar (A4): the PAINTED person-days of ONE month - one row per pseudonym × day
-- that has a staffed tour or a family absence (Ruhetag / Urlaub, catalogue konto_typ, AC-12 family). Q1 ruling
-- (a), 2026-10-21: nothing else is painted per person - «übrige Abwesenheit» and «ohne Eintrag» have no person
-- (D1) and appear only in the Standort × day band, merged. Standort = the person's Heimatstandort (the grid rows
-- are persons); Haupttyp narrows the tour cells only. «(unbesetzt)» is never a row. The person key is the hidden
-- pseudonym_nachbereitung_cd_sk (masked to P-… in every mode); kennung is the Gold label MA-… (masked unless -Real).
DEFINE
    VAR _m = {{month}}
    VAR _ml = IF ( ISBLANK ( _m ),
        CALCULATE ( MIN ( dim_tag_nachbereitung_cd[monat_label] ), dim_tag_nachbereitung_cd[zeitraum] = "Vormonat" ),
        FORMAT ( _m, "yyyy-MM" ) )
    VAR _fM = TREATAS ( { _ml }, dim_tag_nachbereitung_cd[monat_label] )
    VAR _s = {{standort}}
    VAR _sN = MAXX ( FILTER ( ALL ( dim_standort_nachbereitung_cd[standort_name] ),
        RANKX ( ALL ( dim_standort_nachbereitung_cd[standort_name] ), dim_standort_nachbereitung_cd[standort_name], , ASC, DENSE ) = _s ),
        dim_standort_nachbereitung_cd[standort_name] )
    VAR _fHeim = FILTER ( ALL ( dim_pseudonym_nachbereitung_cd[heimatstandort] ),
        ISBLANK ( _s ) || dim_pseudonym_nachbereitung_cd[heimatstandort] = _sN )
    VAR _h = {{haupttyp}}
    VAR _hN = MAXX ( FILTER ( ALL ( fact_tour_cd[personaltyp_haupttyp] ),
        RANKX ( ALL ( fact_tour_cd[personaltyp_haupttyp] ), fact_tour_cd[personaltyp_haupttyp], , ASC, DENSE ) = _h ),
        fact_tour_cd[personaltyp_haupttyp] )
    VAR _fH = FILTER ( ALL ( fact_tour_cd[personaltyp_haupttyp] ), ISBLANK ( _h ) || fact_tour_cd[personaltyp_haupttyp] = _hN )
    VAR _fP = FILTER ( ALL ( dim_pseudonym_nachbereitung_cd[pseudonym] ), dim_pseudonym_nachbereitung_cd[pseudonym] <> "(unbesetzt)" )
EVALUATE
SELECTCOLUMNS (
    SUMMARIZECOLUMNS (
        dim_pseudonym_nachbereitung_cd[pseudonym_nachbereitung_cd_sk],
        dim_pseudonym_nachbereitung_cd[pseudonym],
        dim_pseudonym_nachbereitung_cd[heimatstandort],
        dim_tag_nachbereitung_cd[datum],
        _fM, _fHeim, _fH, _fP,
        "@touren", [Touren besetzt],
        "@ue", [Übernachtungstouren],
        "@ruhe", CALCULATE ( [Abwesenheitstage], KEEPFILTERS ( dim_konto_nachbereitung_cd[konto_typ] = "Ruhetag" ) ),
        "@urlaub", CALCULATE ( [Abwesenheitstage], KEEPFILTERS ( dim_konto_nachbereitung_cd[konto_typ] = "Urlaub" ) )
    ),
    "person", dim_pseudonym_nachbereitung_cd[pseudonym_nachbereitung_cd_sk],
    "kennung", dim_pseudonym_nachbereitung_cd[pseudonym],
    "heimatstandort", dim_pseudonym_nachbereitung_cd[heimatstandort],
    "datum", dim_tag_nachbereitung_cd[datum],
    "touren", [@touren] + 0,
    "uebernachtung", [@ue] + 0,
    "ruhe", [@ruhe] + 0,
    "urlaub", [@urlaub] + 0
)

-- Header, footer and start tile: data as of (model measure + both stamps), the Vormonat of the model's Zurich run
-- day (the app's default month), the horizon, the rule versions and the German Hinweise from the build info.
EVALUATE
ROW (
    "stand", [Stand der Daten],
    "stand_local", MAX ( agg_pipeline_datenstand[datenstand_local] ),
    "stand_utc", MAX ( agg_pipeline_datenstand[datenstand_utc] ),
    "gold_build_ts", MAX ( agg_build_info_nachbereitung_cd[gold_build_ts] ),
    "laufdatum", MAX ( agg_build_info_nachbereitung_cd[laufdatum] ),
    "vormonat", CALCULATE ( MIN ( dim_tag_nachbereitung_cd[monat_label] ), dim_tag_nachbereitung_cd[zeitraum] = "Vormonat" ),
    "daten_ab", MAX ( agg_build_info_nachbereitung_cd[daten_ab] ),
    "erste_tour", MIN ( fact_tour_cd[datum] ),
    "letzte_tour", MAX ( fact_tour_cd[datum] ),
    "touren", [Anzahl Touren],
    "personen", [Anzahl Personen],
    "regel_arbeitszeit", [Regel Arbeitszeit],
    "regel_verkauf", [Regel Verkauf],
    "regel_schulung", [Regel Schulung],
    "regel_uebernachtung", [Regel Übernachtung],
    "regel_paar", MAX ( agg_build_info_nachbereitung_cd[uebernachtung_paar_regel] ),
    "regel_ohne_eintrag", [Regel ohne Eintrag],
    "kontenregel", MAX ( agg_build_info_nachbereitung_cd[kontenregel] ),
    "schwelle_12h", MAX ( agg_build_info_nachbereitung_cd[schwellwert_12h_min] ),
    "schwelle_14h", MAX ( agg_build_info_nachbereitung_cd[schwellwert_14h_min] ),
    "spitzentage", MAX ( agg_build_info_nachbereitung_cd[anzahl_spitzentage] ),
    "touren_ohne_bst", MAX ( agg_build_info_nachbereitung_cd[anzahl_touren_ohne_betriebsstelle] ),
    "az_negativ", MAX ( agg_build_info_nachbereitung_cd[anzahl_arbeitszeit_negativ] ),
    "hinweis_namen", [Hinweis Namen],
    "hinweis_arbeitszeit", [Hinweis Arbeitszeit],
    "hinweis_angerechnet", [Hinweis Angerechnete Zeit],
    "hinweis_14h", [Hinweis Schwellwert 14h],
    "hinweis_verkauf", [Hinweis Verkauf],
    "hinweis_schulung", [Hinweis Schulung],
    "hinweis_uebernachtung", [Hinweis Übernachtung],
    "hinweis_abwesenheit", [Hinweis Abwesenheit],
    "hinweis_ohne_eintrag", [Hinweis Ohne Eintrag],
    "hinweis_standort", [Hinweis Standort],
    "hinweis_datenstand", [Hinweis Datenstand],
    "hinweis_spitzentage", [Hinweis Spitzentage]
)

{
  "model": "au_verleihliste",
  "tenant": "RTS",
  "replaces": "AUE-Verleihliste: KennzahlenDataset + count line («Personen in der Auswahl … aktiv … inaktiv»)",
  "view": "1 KPI band",
  "grain": "one row",
  "params": {
    "status": { "type": "enum", "values": ["AKTIV", "INAKTIV"], "filter_column": "fact_au_verleihliste[Status Code]" },
    "ga": { "type": "enum", "values": ["AU", "DL", "AU_DL"] },
    "taet": { "type": "int", "min": 1, "max": 50 },
    "ort": { "type": "int", "min": 1, "max": 500 },
    "auftrag_nr": { "type": "int", "min": 1, "max": 999 },
    "jahr": { "type": "int", "min": 2000, "max": 2100 },
    "person": { "type": "pseudonym", "filter_column": "fact_au_verleihliste[person_sk]" }
  },
  "columns": {
    "personen": "measure",
    "personen_status_basis": "measure",
    "aktiv": "measure",
    "inaktiv": "measure",
    "personen_ga_basis": "measure",
    "mit_au": "measure",
    "nur_dl": "measure",
    "nur_au": "measure",
    "au_und_dl": "measure",
    "jahr_heute": "measure",
    "austritt_jahr": "measure",
    "austritt_vorjahr": "measure",
    "austritt_geplant": "measure",
    "mit_austritt": "measure",
    "mit_einsatz2": "measure",
    "einsatz1_geplant": "measure",
    "ohne_arbeitszeit": "measure"
  }
}

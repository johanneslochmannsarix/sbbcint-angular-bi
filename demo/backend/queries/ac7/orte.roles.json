{
  "model": "au_verleihliste",
  "tenant": "RTS",
  "replaces": "AUE-Verleihliste: Einsatzort is not printed (the form has no column); the model carries it per stint",
  "view": "5 Where (map + ranked list), filter «Ort»",
  "grain": "one row per location of the two shown stints",
  "params": {
    "status": { "type": "enum", "values": ["AKTIV", "INAKTIV"], "filter_column": "fact_au_verleihliste[Status Code]" },
    "ga": { "type": "enum", "values": ["AU", "DL", "AU_DL"] },
    "taet": { "type": "int", "min": 1, "max": 50 },
    "ort": { "type": "int", "min": 1, "max": 500 },
    "auftrag_nr": { "type": "int", "min": 1, "max": 999 },
    "jahr": { "type": "int", "min": 2000, "max": 2100 },
    "person": { "type": "pseudonym", "filter_column": "fact_au_verleihliste[person_sk]" }
  },
  "columns": {
    "rang": "id",
    "ort": "label_location",
    "personen_einsatz1": "measure",
    "personen_einsatz2": "measure",
    "personen": "measure"
  },
  "note": "The view ignores its own `ort` filter (accepted but unused); the app does not send it."
}

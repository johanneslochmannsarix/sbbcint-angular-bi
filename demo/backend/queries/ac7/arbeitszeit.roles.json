{
  "model": "au_verleihliste",
  "tenant": "RTS",
  "replaces": "AUE-Verleihliste: column «Arbeitszeit» (h/Monat until the VZ/TZ/GfB rule exists)",
  "view": "6 Arbeitszeit mix",
  "grain": "contractual monthly hours value × status",
  "params": {
    "status": { "type": "enum", "values": ["AKTIV", "INAKTIV"], "filter_column": "fact_au_verleihliste[Status Code]" },
    "ga": { "type": "enum", "values": ["AU", "DL", "AU_DL"] },
    "taet": { "type": "int", "min": 1, "max": 50 },
    "ort": { "type": "int", "min": 1, "max": 500 },
    "auftrag_nr": { "type": "int", "min": 1, "max": 999 },
    "jahr": { "type": "int", "min": 2000, "max": 2100 },
    "person": { "type": "pseudonym", "filter_column": "fact_au_verleihliste[person_sk]" }
  },
  "columns": {
    "stunden": "measure",
    "status_code": "code",
    "personen": "measure"
  }
}

{
  "model": "au_verleihliste",
  "tenant": "RTS",
  "replaces": "AUE-Verleihliste: dataset VerleihlisteDataset (the tablix rows)",
  "view": "2 Einsatz-Timeline, 4 stint lengths, 7 person drawer, 8 Formular",
  "grain": "one row per person on the list",
  "params": {
    "status": { "type": "enum", "values": ["AKTIV", "INAKTIV"], "filter_column": "fact_au_verleihliste[Status Code]" },
    "ga": { "type": "enum", "values": ["AU", "DL", "AU_DL"] },
    "taet": { "type": "int", "min": 1, "max": 50 },
    "ort": { "type": "int", "min": 1, "max": 500 },
    "auftrag_nr": { "type": "int", "min": 1, "max": 999 },
    "jahr": { "type": "int", "min": 2000, "max": 2100 },
    "person": { "type": "pseudonym", "filter_column": "fact_au_verleihliste[person_sk]" }
  },
  "columns": {
    "person_sk": "label_person",
    "nachname": "label_person",
    "vorname": "label_person",
    "status_code": "code",
    "status": "code",
    "geschaeftsart": "code",
    "taetigkeit": "label_org",
    "arbeitszeit_monat_h": "measure",
    "arbeitszeit_woche_h": "measure",
    "vertrag_gueltig": "code",
    "eintritt": "date",
    "austritt": "date",
    "einsatz1_von": "date",
    "einsatz1_bis": "date",
    "einsatz1_ort": "label_location",
    "einsatz1_anzahl_orte": "measure",
    "einsatz1_auftrag": "label_freetext",
    "einsatz1_geschaeftsart": "code",
    "einsatz2_von": "date",
    "einsatz2_bis": "date",
    "einsatz2_ort": "label_location",
    "einsatz2_anzahl_orte": "measure",
    "einsatz2_auftrag": "label_freetext",
    "einsatz2_geschaeftsart": "code",
    "anzahl_verleihstationen": "measure",
    "erster_einsatz_von": "date",
    "letzter_einsatz_bis": "date"
  },
  "person_key": "person_sk",
  "note": "Nachname / Vorname = person labels (pseudonym in masked mode); order names = free text (token). Eintritt is a proxy (earliest validefrom), Austritt the contractend fallback until SAX-35."
}

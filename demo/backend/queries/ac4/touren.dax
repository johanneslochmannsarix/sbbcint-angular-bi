-- View 6 list: the tours of ONE Tourstandort in ONE Planmonat - the report's drillthrough «Tourstandort»
-- table (Tour, Tour Plandatum, Personaltyp Tour × Elemente, Plandauer, Plandauer Fahren, Ist erfasst) plus
-- the tour's derived Ist coverage (F4) and its angerechnete Zeit (F3, a tour attribute: one value per tour).
-- No person column. «Tour» is the shift name typed in SaxMS: label_freetext (token in masked mode).
DEFINE
    VAR _m = {{month}}
    VAR _st = {{standort}}
    VAR _pt = {{ptyp}}
    VAR _ta = {{taet}}
    VAR _ptName =
        MAXX (
            FILTER (
                ADDCOLUMNS (
                    ALL ( fico_disposition[Personaltyp Tour] ),
                    "@rang",
                        VAR v = fico_disposition[Personaltyp Tour]
                        RETURN COUNTROWS ( FILTER ( ALL ( fico_disposition[Personaltyp Tour] ), fico_disposition[Personaltyp Tour] <= v ) )
                ),
                [@rang] = _pt
            ),
            fico_disposition[Personaltyp Tour]
        )
    VAR _fMonat = FILTER ( ALL ( fico_disposition[Planmonat] ), fico_disposition[Planmonat] = FORMAT ( _m, "yyyy-MM" ) )
    VAR _fStandort = FILTER ( ALL ( fico_disposition[depot_sk] ), fico_disposition[depot_sk] = _st )
    VAR _fPtyp = FILTER ( ALL ( fico_disposition[Personaltyp Tour] ), ISBLANK ( _pt ) || fico_disposition[Personaltyp Tour] = _ptName )
    VAR _fTaet = FILTER ( ALL ( fico_disposition[worker_activity_sk] ), ISBLANK ( _ta ) || fico_disposition[worker_activity_sk] = _ta )
EVALUATE
SELECTCOLUMNS (
    SUMMARIZECOLUMNS (
        fico_disposition[tour_id], fico_disposition[Tour], fico_disposition[Tour Plandatum], fico_disposition[Tour Planbeginn],
        fico_disposition[Tour Planende], fico_disposition[Personaltyp Tour], fico_disposition[Tour Ist Abdeckung],
        fico_disposition[Tour angerechnete Zeit (min)],
        _fMonat, _fStandort, _fPtyp, _fTaet,
        "tourelemente", [Anzahl Tourelemente (Disposition)],
        "plandauer_h", [Plandauer Tourelemente (Disposition) [h]]],
        "fahren_h", [Plandauer Fahren (Disposition) [h]]],
        "elemente_mit_ist", [Elemente mit Ist (Disposition)],
        "ist_erfassung", [Ist-Erfassungsgrad vergangene Elemente (Disposition) [%]]]
    ),
    "tour_id", fico_disposition[tour_id],
    "tour", fico_disposition[Tour],
    "tour_plandatum", fico_disposition[Tour Plandatum],
    "tour_planbeginn", fico_disposition[Tour Planbeginn],
    "tour_planende", fico_disposition[Tour Planende],
    "personaltyp_tour", fico_disposition[Personaltyp Tour],
    "abdeckung", fico_disposition[Tour Ist Abdeckung],
    "anger_min", fico_disposition[Tour angerechnete Zeit (min)],
    "tourelemente", [tourelemente],
    "plandauer_h", [plandauer_h],
    "fahren_h", [fahren_h],
    "elemente_mit_ist", [elemente_mit_ist],
    "ist_erfassung", [ist_erfassung]
)
ORDER BY [tour_planbeginn]

-- View 1 (Produktivität): one row per Firma × Tourstandort - the report's table «Tourstandorte nach Touren»
-- (page Übersicht) with its measures, plus (*) tours with angerechnete Zeit (fill, F3). Firma = the
-- Tourstandort's company (tour_firma, F1). Not filtered by Firma / Tourstandort: the treemap shows them
-- all and the selection zooms; filtered by Planmonat, Personaltyp Tour (rank) and Tätigkeit.
DEFINE
    VAR _m = {{month}}
    VAR _pt = {{ptyp}}
    VAR _ta = {{taet}}
    VAR _ptName =
        MAXX (
            FILTER (
                ADDCOLUMNS (
                    ALL ( fico_disposition[Personaltyp Tour] ),
                    "@rang",
                        VAR v = fico_disposition[Personaltyp Tour]
                        RETURN COUNTROWS ( FILTER ( ALL ( fico_disposition[Personaltyp Tour] ), fico_disposition[Personaltyp Tour] <= v ) )
                ),
                [@rang] = _pt
            ),
            fico_disposition[Personaltyp Tour]
        )
    VAR _fMonat = FILTER ( ALL ( fico_disposition[Planmonat] ), ISBLANK ( _m ) || fico_disposition[Planmonat] = FORMAT ( _m, "yyyy-MM" ) )
    VAR _fPtyp = FILTER ( ALL ( fico_disposition[Personaltyp Tour] ), ISBLANK ( _pt ) || fico_disposition[Personaltyp Tour] = _ptName )
    VAR _fTaet = FILTER ( ALL ( fico_disposition[worker_activity_sk] ), ISBLANK ( _ta ) || fico_disposition[worker_activity_sk] = _ta )
EVALUATE
SELECTCOLUMNS (
    SUMMARIZECOLUMNS (
        fico_disposition[Firma], fico_disposition[Tourstandort], fico_disposition[depot_sk],
        _fMonat, _fPtyp, _fTaet,
        "touren", [Anzahl Touren (Disposition)],
        "tourelemente", [Anzahl Tourelemente (Disposition)],
        "plandauer_touren_h", [Plandauer Touren (Disposition) [h]]],
        "plandauer_h", [Plandauer Tourelemente (Disposition) [h]]],
        "fahren_h", [Plandauer Fahren (Disposition) [h]]],
        "dauer_je_tour_h", [Durchschnitt Dauer je Tour (Disposition) [h]]],
        "fahranteil", [Fahranteil (Disposition) [%]]],
        "anteil_person", [Anteil Person eingeteilt (Disposition) [%]]],
        "personen", [Anzahl Personen eingeteilt (Disposition)],
        "ist_erfassung", [Ist-Erfassungsgrad vergangene Elemente (Disposition) [%]]],
        "elemente_mit_ist", [Elemente mit Ist (Disposition)],
        "touren_anger", CALCULATE ( DISTINCTCOUNT ( fico_disposition[tour_id] ), KEEPFILTERS ( NOT ISBLANK ( fico_disposition[Tour angerechnete Zeit (min)] ) ) )
    ),
    "firma", fico_disposition[Firma],
    "tourstandort", fico_disposition[Tourstandort],
    "depot_sk", fico_disposition[depot_sk],
    "touren", [touren],
    "tourelemente", [tourelemente],
    "plandauer_touren_h", [plandauer_touren_h],
    "plandauer_h", [plandauer_h],
    "fahren_h", [fahren_h],
    "dauer_je_tour_h", [dauer_je_tour_h],
    "fahranteil", [fahranteil],
    "anteil_person", [anteil_person],
    "personen", [personen],
    "ist_erfassung", [ist_erfassung],
    "elemente_mit_ist", [elemente_mit_ist],
    "touren_anger", [touren_anger]
)

    "taet": { "type": "int", "min": 1, "max": 400 },
    "tag": { "type": "int", "min": 0, "max": 7 }
  },
  "columns": {
    "tour_id": "id",
    "tour": "label_freetext",
    "personaltyp": "label_org",
    "tag": "measure",
    "start_ms": "measure",
    "ende_ms": "measure",
    "elemente": "measure",
    "dauer_h": "measure",
    "fahren_h": "measure"
  }
}

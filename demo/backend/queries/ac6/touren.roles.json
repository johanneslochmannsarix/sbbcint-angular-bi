{
  "model": "fico",
  "tenant": "CARGOCONTROL",
  "replaces": "the tour rows behind the version table of page «Planung (JUP)» (the report shows no tour list)",
  "view": "6 tour drill: tour list of one Tourstandort",
  "grain": "one row per tour of one version and Tourstandort",
  "params": {
    "version": { "type": "int", "min": 1, "max": 60, "required": true },
    "standort": { "type": "int", "min": 1, "max": 200, "required": true },
